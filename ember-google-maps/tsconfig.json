{
  "extends": "@ember/library-tsconfig",
  "include": [
    "src/**/*.ts",
    "src/**/*.gts",
    "unpublished-development-types/**/*"
  ],
  "glint": {
    "environment": []
  },
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "types": ["ember-source/types", "@glint/ember-tsc/types", "google.maps"]
  }
}
